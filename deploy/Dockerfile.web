FROM node:22-bookworm-slim AS assets
WORKDIR /build
COPY workbench/package.json workbench/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY workbench/resources ./resources
COPY workbench/app ./app
COPY workbench/public/assets ./public/assets
COPY workbench/tailwind.config.cjs workbench/vite.config.js ./
RUN npm run build

FROM nginx:1.27-alpine
COPY workbench/public /var/www/html/public
COPY --from=assets /build/public/css /var/www/html/public/css
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
RUN ln -s /var/www/html/storage/app/public /var/www/html/public/storage
